# ══════════════════════════════════════════════════════════
#  ICT Trading Lab — متغيرات البيئة
#  انسخ هذا الملف إلى .env وأدخل بياناتك الحقيقية
#  لا ترفع ملف .env على GitHub أبداً!
# ══════════════════════════════════════════════════════════

# ── AI Keys ──────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# ══════════════════════════════════════════════════════════
#  BROKER SELECTOR
#  اختر البروكر: paper | mt5 | ctrader
# ══════════════════════════════════════════════════════════
BROKER=paper

# ══════════════════════════════════════════════════════════
#  MT5 — MetaTrader 5 Demo Account
# ══════════════════════════════════════════════════════════

# رقم الحساب (Login Number)
MT5_LOGIN=your_mt5_login

# كلمة المرور
MT5_PASSWORD=your_mt5_password

# اسم السيرفر (يظهر في منصة MT5 عند تسجيل الدخول)
MT5_SERVER=your_broker_server

# حساب Demo؟ (true = Demo, false = Live)
MT5_DEMO=true

# Magic Number لتمييز الصفقات (أي رقم فريد)
MT5_MAGIC=123456

# أسماء الرموز في MT5 (تختلف حسب الوسيط — تحقق من قائمة الرموز في MT5)
MT5_SYMBOL_US30=US30
MT5_SYMBOL_US100=NAS100
MT5_SYMBOL_US500=US500

# ══════════════════════════════════════════════════════════
#  LIVE TRADING — cTrader + FUNDEDHIVE
# ══════════════════════════════════════════════════════════

# حساب Demo أم Live؟
CTRADER_DEMO=false

# ── بيانات cTrader Open API ───────────────────────────────
# احصل عليها من: https://openapi.ctrader.com/
# 1. أنشئ تطبيقاً جديداً
# 2. انسخ Client ID و Client Secret
CTRADER_CLIENT_ID=your_client_id
CTRADER_CLIENT_SECRET=your_client_secret

# ── حساب FUNDEDHIVE ────────────────────────────────────────
# Account ID: رقم حسابك في cTrader (يظهر في منصة cTrader)
CTRADER_ACCOUNT_ID=0

# Access Token: احصل عليه من OAuth2 flow
# الرابط: https://connect.spotware.com/apps/token?grant_type=authorization_code
# أو استخدم سكريبت auth المرفق
CTRADER_ACCESS_TOKEN=your_access_token

# ── أسماء الأدوات في cTrader عند FUNDEDHIVE ───────────────
# تحقق من الأسماء الدقيقة في منصة cTrader (قد تختلف)
CT_SYMBOL_US30=US30
CT_SYMBOL_US100=NAS100
CT_SYMBOL_US500=US500

# قيمة النقطة لكل Lot (USD) — اسأل FUNDEDHIVE عن المواصفات
# مثال: إذا 1 lot US30 = 1$/نقطة → CT_POINT_VALUE_PER_LOT=1.0
CT_POINT_VALUE_PER_LOT=1.0

# ══════════════════════════════════════════════════════════
#  قواعد FUNDEDHIVE (عدّل حسب خطتك)
# ══════════════════════════════════════════════════════════

# رصيد الحساب الابتدائي ($)
PROPFIRM_INITIAL_BALANCE=10000

# حد الخسارة اليومية (%)
PROPFIRM_MAX_DAILY_LOSS_PCT=0.05

# حد الـ Drawdown الإجمالي (%)
PROPFIRM_MAX_DRAWDOWN_PCT=0.10

# هدف الربح (%)
PROPFIRM_PROFIT_TARGET_PCT=0.10

# أقل عدد أيام تداول
PROPFIRM_MIN_TRADING_DAYS=5

# أقصى حجم صفقة (Lots)
PROPFIRM_MAX_LOT_PER_TRADE=5.0

# إغلاق الصفقات قبل نهاية الأسبوع (true/false)
PROPFIRM_CLOSE_ON_WEEKEND=true

# نافذة حظر الأخبار بالدقائق (0 = معطّل)
PROPFIRM_NO_NEWS_WINDOW_MIN=0

# ══════════════════════════════════════════════════════════
#  إعدادات أخرى
# ══════════════════════════════════════════════════════════
PORT=8000
ENABLE_AI_COUNCIL=true
COUNCIL_HARD_VETO=true
AI_ENTER_MIN_CONFIDENCE=6
